# LabControl 4.0 - modelo de variaveis de ambiente (GOV-05)
#
# COMO USAR
#   1. Copie este arquivo para o repositorio que o utiliza (ex.: labcontrol-api/.env.example)
#      e crie um ".env" local a partir dele.
#   2. Preencha os valores SOMENTE no ".env" local. Nunca versione o ".env".
#   3. Garanta que ".env" esteja no .gitignore do repositorio.
#   4. Todos os valores abaixo sao FICTICIOS (<...>). Nao coloque credenciais reais aqui.
#
# Ao rotacionar uma credencial, atualize apenas o ".env" local / secret store.

# --- API (labcontrol-api) -----------------------------------------------------
ASPNETCORE_ENVIRONMENT=Development
# Obrigatoria: a API nao inicia sem Jwt__Key. Use um valor aleatorio com 32+ caracteres.
Jwt__Key=<chave-aleatoria-minimo-32-caracteres>
Jwt__Issuer=LabControlApi
ConnectionStrings__DefaultConnection=Host=postgres;Port=5432;Database=labcontroldb;Username=<usuario-db>;Password=<senha-db>
# Necessaria apenas para o chat com IA
GEMINI_API_KEY=<chave-da-api-de-ia>

# --- Broker MQTT consumido pela API -------------------------------------------
Mqtt__Host=mosquitto
Mqtt__Port=1883
Mqtt__Topic=lab/machine/metrics

# --- PostgreSQL (container) ---------------------------------------------------
POSTGRES_DB=labcontroldb
POSTGRES_USER=<usuario-db>
POSTGRES_PASSWORD=<senha-db>

# --- Broker MQTT com autenticacao (PLANEJADO - IOT-02) ------------------------
MQTT_USERNAME=<usuario-mqtt>
MQTT_PASSWORD=<senha-mqtt>

# --- Mobile (Expo) (PROPOSTO) --------------------------------------------------
# Hoje a URL da API esta fixa no codigo do app; esta variavel substituiria isso.
EXPO_PUBLIC_API_URL=http://<host-da-api>:8080/api
